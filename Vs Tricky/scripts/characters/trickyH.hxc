import flixel.FlxG;
import flixel.FlxSprite;
import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.play.character.MultiSparrowCharacter;
import funkin.play.GameOverSubState;
import funkin.play.PlayState;

import funkin.FunkinMemory;

class TrickyHellclownCharacter extends MultiSparrowCharacter
{
	function new()
	{
		super("trickyH");
	}
	
	function onUpdate(event:ScriptEvent)
	{
		super.onUpdate(event);
		
		if (PlayState.instance != null && PlayState.instance.currentStage != null)
		{
			var dad = PlayState.instance.currentStage.getDad();
			if (dad != null && dad.isSinging())
				FlxG.camera.shake(0.02,0.2);
		}
	}
}
